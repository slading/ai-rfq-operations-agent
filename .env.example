# ===========================================================================
# AI RFQ Operations Agent - environment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored; `.env.example` is not.
# Every variable is prefixed with RFQ_ and maps to a field in
# rfq_agent.config.Settings (nested via RFQ_<SECTION>__<FIELD>).
# ===========================================================================

# --- Application -----------------------------------------------------------
# One of: development, production. Production turns on log/prompt redaction
# and turns off full exception details in trace records.
RFQ_ENV=development
RFQ_LOG_LEVEL=INFO
# True  -> redact secrets/PII from logs and store prompt hashes only.
# False -> dev convenience: full payloads may be persisted. NEVER false in prod.
RFQ_REDACT_LOGS=true
# Where the JSON-lines application log is written ("-" means stdout only).
RFQ_LOG_FILE=-

# --- LLM provider (Groq, V1) ----------------------------------------------
# REQUIRED. Create one at https://console.groq.com - never commit it.
RFQ_GROQ__API_KEY=
RFQ_GROQ__BASE_URL=https://api.groq.com/openai/v1
# Decision D1: openai/gpt-oss-120b is the V1 default. Model IDs are config,
# never hardcoded, so swapping providers/models is a config-only change.
RFQ_GROQ__AGENT_MODEL=openai/gpt-oss-120b
RFQ_GROQ__TRIAGE_MODEL=openai/gpt-oss-120b
# Decision D4: design around the free tier (30 RPM / 8K TPM / 1k requests/day).
# The in-process budget below must stay UNDER the provider limit; correctness
# guarantees are never relaxed to save requests - we queue and back off instead.
RFQ_GROQ__REQUESTS_PER_MINUTE_BUDGET=24
RFQ_GROQ__TOKENS_PER_MINUTE_BUDGET=7000
RFQ_GROQ__REQUEST_TIMEOUT_SECONDS=30.0
# Retries for transient provider failures (429/5xx/timeout). Bounded and
# jittered; exhausting them yields FAILED_RETRYABLE, never a guessed answer.
RFQ_GROQ__RETRY__MAX_ATTEMPTS=4
RFQ_GROQ__RETRY__BASE_DELAY_SECONDS=1.0
RFQ_GROQ__RETRY__MAX_DELAY_SECONDS=30.0
RFQ_GROQ__RETRY__JITTER_RATIO=0.2

# --- Agent loop budgets ----------------------------------------------------
# Hard ceilings. Exceeding any of them ends the run in a human-waiting or
# retryable-failed state; none of them may be exceeded to "finish the job".
RFQ_AGENT__MAX_STEPS=8
RFQ_AGENT__MAX_TOOL_ATTEMPTS_PER_TOOL=3
RFQ_AGENT__MAX_TOOL_RESULT_BYTES=8192
RFQ_AGENT__RUN_BUDGET_SECONDS=60.0
# Structured-output repair attempts before escalating to a human.
RFQ_AGENT__MAX_REPAIR_ATTEMPTS=2
# Sampling is fixed: extraction must be as reproducible as the provider allows.
RFQ_AGENT__TEMPERATURE=0.0
RFQ_AGENT__RANDOM_SEED=1337

# --- Trust / security ------------------------------------------------------
# Cheap heuristic gate first; the classifier model is only consulted when the
# heuristic is suspicious or when RFQ_TRUST__ALWAYS_CLASSIFY=true.
RFQ_TRUST__ALWAYS_CLASSIFY=false
# Decision D6: layered defence. Set to "" to run heuristics-only.
RFQ_TRUST__CLASSIFIER_MODEL=openai/gpt-oss-safeguard-20b
# A single leaked canary or cross-customer value blocks the outbound send.
RFQ_TRUST__CANARY_SCAN_STRICT=true
# Untrusted bodies are stored once, in full, on the rfq row; everything else
# references them by id. This caps what the *agent* is shown, not what we store.
RFQ_TRUST__MAX_UNTRUSTED_BYTES=65536

# --- Workflow policy -------------------------------------------------------
# V1 has no auto-send path: every quote waits for a human. These knobs exist
# so the policy is explicit in config rather than buried in code.
RFQ_WORKFLOW__REQUIRE_HUMAN_APPROVAL=true
RFQ_WORKFLOW__AUTO_APPROVE_ENABLED=false
RFQ_WORKFLOW__MAX_RUN_ATTEMPTS=3
RFQ_WORKFLOW__RUN_QUEUE_POLL_SECONDS=1.0

# --- Business defaults (Phase 1 owns the real policy tables) ---------------
RFQ_BUSINESS__CURRENCY=EUR
# Quotes are net of tax in V1; the rate is displayed, not applied.
RFQ_BUSINESS__TAX_DISPLAY_ONLY=true
RFQ_BUSINESS__PRICE_STALENESS_DAYS=180
RFQ_BUSINESS__MAX_QUANTITY_PER_LINE=10000

# --- HTTP / UI -------------------------------------------------------------
RFQ_HTTP__HOST=0.0.0.0
RFQ_HTTP__PORT=8000
# Decision D2: FastAPI + Jinja2 + HTMX + minimal Alpine.js. No React/Vite.
RFQ_HTTP__UI_TEMPLATE_DIR=src/rfq_agent/ui/templates
# V1 auth is a single static operator token (placeholder, not a user system).
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
RFQ_HTTP__OPERATOR_TOKEN=

# --- Persistence (Phase 1) -------------------------------------------------
# Decision: SQLite in WAL mode behind SQLAlchemy 2.0. Path is declared here so
# config is complete, but no DB code exists in Phase 0.
RFQ_DATABASE__URL=sqlite:///var/rfq_agent.db
RFQ_DATABASE__ECHO=false

# --- Evaluation (Phase 7) --------------------------------------------------
# Decision D3: offline replay is the default and the only CI path.
# RFQ_LLM_MODE=replay never touches the network. "live" is opt-in and gated by
# the `live` pytest marker.
RFQ_LLM_MODE=replay
RFQ_RECORDINGS_DIR=recordings
